<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Key mapper</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Courier+Prime:wght@400;700&family=Special+Elite&display=swap" rel="stylesheet">
<style>
  :root{
    --ink-bg: #201c18;
    --paper: #ece5d6;
    --paper-dim: #b9b0a0;
    --key-face: #37312a;
    --key-face-hover: #423b32;
    --key-ring: #574e42;
    --brass: #c99149;
    --brass-dim: #7a5a30;
    --danger: #b5533f;
    --ok: #7fa66a;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background: var(--ink-bg);
    color: var(--paper);
    font-family: 'Courier Prime', monospace;
    min-height:100vh;
    display:flex;
    flex-direction:column;
    align-items:center;
    padding: 32px 16px 48px;
  }
  h1{
    font-family:'Special Elite', 'Courier Prime', monospace;
    font-weight:400;
    font-size:22px;
    letter-spacing:1px;
    margin:0 0 4px;
    color:var(--paper);
  }
  .subtitle{
    font-size:12px;
    color:var(--paper-dim);
    margin:0 0 20px;
    text-align:center;
    max-width:480px;
    line-height:1.6;
  }
  .toolbar{
    display:flex;
    gap:10px;
    align-items:center;
    margin-bottom:28px;
    flex-wrap:wrap;
    justify-content:center;
  }
  button.action{
    font-family:'Courier Prime', monospace;
    font-size:12px;
    letter-spacing:0.5px;
    background:var(--key-face);
    color:var(--paper);
    border:1px solid var(--key-ring);
    border-radius:4px;
    padding:8px 14px;
    cursor:pointer;
  }
  button.action:hover{ background:var(--key-face-hover); }
  button.action.danger{ border-color:var(--danger); color:var(--danger); }
  #status{
    font-size:11px;
    color:var(--paper-dim);
    min-width:150px;
  }
  #status.ok{ color:var(--ok); }
  #status.err{ color:var(--danger); }
  .board{
    display:flex;
    flex-direction:column;
    align-items:flex-start;
    gap:10px;
  }
  .row{
    display:flex;
    gap:10px;
  }
  .key{
    width:54px;
    height:54px;
    border-radius:50%;
    background:var(--key-face);
    border:1px solid var(--key-ring);
    display:flex;
    flex-direction:column;
    align-items:stretch;
    justify-content:center;
    position:relative;
    cursor:text;
    overflow:hidden;
  }
  .key:hover{ background:var(--key-face-hover); }
  .half{
    flex:1;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:11px;
    line-height:1;
    color:var(--paper-dim);
    outline:none;
    white-space:nowrap;
    overflow:hidden;
    padding:2px 4px;
  }
  .half.top{ border-bottom: 0.5px solid var(--key-ring); }
  .half.active{
    background:var(--brass);
    color:#231a0e;
    font-weight:700;
  }
  .shift-row{
    margin-top:4px;
  }
  .shift-key{
    width:150px;
    height:64px;
    border-radius:32px;
    background:var(--key-face);
    border:1.5px solid var(--brass-dim);
    display:flex;
    align-items:center;
    justify-content:center;
    font-family:'Special Elite', monospace;
    font-size:14px;
    letter-spacing:2px;
    color:var(--paper);
    cursor:pointer;
    user-select:none;
  }
  .shift-key.on{
    background:var(--brass);
    color:#231a0e;
    border-color:var(--brass);
  }
  .shift-key:hover{ filter:brightness(1.1); }
  .hint{
    font-size:10px;
    color:var(--paper-dim);
    margin-top:20px;
    text-align:center;
    max-width:420px;
    line-height:1.6;
  }
  .setup-banner{
    background:#3a2a1e;
    border:1px solid var(--brass-dim);
    border-radius:6px;
    padding:14px 16px;
    max-width:520px;
    font-size:11px;
    line-height:1.7;
    margin-bottom:24px;
    color:var(--paper);
  }
  .setup-banner code{
    background:#20180f;
    padding:1px 5px;
    border-radius:3px;
    color:var(--brass);
  }
</style>
</head>
<body>

<h1>Key mapper</h1>
<p class="subtitle">42 keys, two phrases per key. Click a half to edit it (up to 4 characters). Use SHIFT to switch which phrase is highlighted across the board. Edits sync live to everyone viewing this page.</p>

<div id="setupBanner" class="setup-banner" style="display:none">
  This board isn't connected to shared storage yet. Open <code>typewriter-key-mapper.html</code>,
  find the <code>firebaseConfig</code> object near the top of the script, and paste in your own
  Firebase project's config (see setup steps below). Until then, edits only stay in this browser tab.
</div>

<div class="toolbar">
  <button class="action danger" id="clearBtn">Clear all</button>
  <span id="status">Connecting…</span>
</div>

<div class="board" id="board"></div>

<div class="shift-row">
  <div class="shift-key" id="shiftKey">SHIFT</div>
</div>

<p class="hint">Row layout: 10 / 11 / 11 / 10, with SHIFT anchored bottom left, matching a typewriter's stagger.</p>

<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
<script>
// ---- PASTE YOUR FIREBASE CONFIG HERE ----
// Create a free project at https://console.firebase.google.com, enable
// "Realtime Database" (start in test mode), then copy the config object
// from Project settings > General > Your apps > SDK setup and configuration.
const firebaseConfig = {
  apiKey: "",
  authDomain: "",
  databaseURL: "",
  projectId: "",
  storageBucket: "",
  messagingSenderId: "",
  appId: ""
};
// ------------------------------------------

const ROW_SIZES = [10, 11, 11, 10];
const TOTAL_KEYS = ROW_SIZES.reduce((a,b)=>a+b,0);
const ROW_OFFSETS = [0, 28, 42, 66];

let keys = Array.from({length: TOTAL_KEYS}, () => ({a:'', b:''}));
let shiftOn = false;
let dbRef = null;
let applyingRemote = false;
let writeTimer = null;

const boardEl = document.getElementById('board');
const statusEl = document.getElementById('status');
const shiftKeyEl = document.getElementById('shiftKey');
const setupBanner = document.getElementById('setupBanner');

function clampText(s){
  return (s || '').replace(/\n/g,'').slice(0,4);
}

function render(){
  const focused = document.activeElement;
  const focusedInfo = (focused && focused.classList && focused.classList.contains('half'))
    ? { keyIndex: Number(focused.dataset.keyIndex), which: focused.dataset.which }
    : null;

  boardEl.innerHTML = '';
  let idx = 0;
  ROW_SIZES.forEach((count, rowIdx) => {
    const row = document.createElement('div');
    row.className = 'row';
    row.style.marginLeft = ROW_OFFSETS[rowIdx] + 'px';
    for(let i=0; i<count; i++){
      const k = idx;
      const data = keys[k];
      const keyEl = document.createElement('div');
      keyEl.className = 'key';

      const topEl = document.createElement('div');
      topEl.className = 'half top' + (!shiftOn ? ' active' : '');
      topEl.contentEditable = 'true';
      topEl.spellcheck = false;
      topEl.dataset.keyIndex = k;
      topEl.dataset.which = 'a';
      topEl.textContent = data.a;
      topEl.addEventListener('input', () => {
        data.a = clampText(topEl.textContent);
        if(clampText(topEl.textContent) !== topEl.textContent) topEl.textContent = data.a;
        scheduleWrite();
      });
      topEl.addEventListener('keydown', (e) => { if(e.key === 'Enter') e.preventDefault(); });

      const bottomEl = document.createElement('div');
      bottomEl.className = 'half bottom' + (shiftOn ? ' active' : '');
      bottomEl.contentEditable = 'true';
      bottomEl.spellcheck = false;
      bottomEl.dataset.keyIndex = k;
      bottomEl.dataset.which = 'b';
      bottomEl.textContent = data.b;
      bottomEl.addEventListener('input', () => {
        data.b = clampText(bottomEl.textContent);
        if(clampText(bottomEl.textContent) !== bottomEl.textContent) bottomEl.textContent = data.b;
        scheduleWrite();
      });
      bottomEl.addEventListener('keydown', (e) => { if(e.key === 'Enter') e.preventDefault(); });

      keyEl.appendChild(topEl);
      keyEl.appendChild(bottomEl);
      row.appendChild(keyEl);
      idx++;
    }
    boardEl.appendChild(row);
  });
  shiftKeyEl.classList.toggle('on', shiftOn);

  if(focusedInfo){
    const selector = '.half[data-key-index="' + focusedInfo.keyIndex + '"][data-which="' + focusedInfo.which + '"]';
    const el = boardEl.querySelector(selector);
    if(el){
      el.focus();
      const range = document.createRange();
      range.selectNodeContents(el);
      range.collapse(false);
      const sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(range);
    }
  }
}

function scheduleWrite(){
  setStatus('Editing…', '');
  clearTimeout(writeTimer);
  writeTimer = setTimeout(writeToDb, 400);
}

function setStatus(text, cls){
  statusEl.textContent = text;
  statusEl.className = cls || '';
}

function writeToDb(){
  if(!dbRef){
    setStatus('Not connected — see banner above', 'err');
    return;
  }
  applyingRemote = true;
  dbRef.set({ keys: keys }).then(() => {
    setStatus('Synced', 'ok');
    applyingRemote = false;
  }).catch(() => {
    setStatus('Sync failed', 'err');
    applyingRemote = false;
  });
}

document.getElementById('clearBtn').addEventListener('click', () => {
  keys = Array.from({length: TOTAL_KEYS}, () => ({a:'', b:''}));
  render();
  scheduleWrite();
});

shiftKeyEl.addEventListener('click', () => {
  shiftOn = !shiftOn;
  render();
});

function initFirebase(){
  if(!firebaseConfig.databaseURL){
    setupBanner.style.display = 'block';
    setStatus('Local only (no shared storage configured)', 'err');
    render();
    return;
  }
  try{
    firebase.initializeApp(firebaseConfig);
    dbRef = firebase.database().ref('typewriter-board');
    dbRef.on('value', (snapshot) => {
      const val = snapshot.val();
      if(val && Array.isArray(val.keys) && val.keys.length === TOTAL_KEYS){
        keys = val.keys;
      }
      setStatus('Synced', 'ok');
      render();
    }, () => {
      setStatus('Connection error', 'err');
    });
  }catch(err){
    setupBanner.style.display = 'block';
    setStatus('Connection error — check config', 'err');
    render();
  }
}

initFirebase();
</script>
</body>
</html>
